# ============================================================
# BimaSorgum (SorghumCare) — Environment Template
#
# Cara pakai:
#   1. Salin file ini menjadi `.env.local` (untuk dev lokal)
#      ATAU set variabel ini di dashboard host/CI server teman.
#   2. Isi nilai asli (jangan commit .env.local ke git).
#   3. Build:  npm install && npm run build  -> hasil di folder dist/
#   4. Upload dist/ ke server static apa pun (Vercel/Netlify/nginx...).
#
# CATATAN KEAMANAN:
#   Semua variabel VITE_* ikut ter-bundle ke JavaScript publik,
#   jadi HANYA boleh berisi kunci publik (anon/publishable).
#   JANGAN masukkan service_role / secret server ke sini.
# ============================================================

# ---- Supabase (WAJIB) ---------------------------------------
# Project URL + kunci ANON/publishable (bukan service_role).
# Ambil dari: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://<ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_..."

# ---- Backend AI / LLM (OPSIONAL — sudah ada default di kode) --
# Default di src/services/bimaClient.ts: https://api.llmsorgum.online
# Hanya set jika ingin menimpa/self-host backend sendiri.
VITE_BIMA_API_URL=""
# Biarkan kosong = pakai model default backend (lihat /api/config).
VITE_BIMA_MODEL=""
# Hanya diisi bila backend memakai API key (opsional; default kosong).
VITE_BIMA_API_KEY=""
